# --- Tiger Cloud / PostgreSQL ---
# Full connection string for your Tiger Cloud (TimescaleDB) service.
# Get it with:  tiger db uri <service-id> --with-password
DATABASE_URL=postgresql://tsdbadmin:CHANGE_ME@your-service.tsdb.cloud.timescale.com:PORT/tsdb?sslmode=require

# --- Embeddings ---
# auto      -> try a local model (fastembed, then sentence-transformers),
#              fall back to the offline hash embedder
# fastembed -> local ONNX model via fastembed (default, 384-dim)
# local     -> sentence-transformers
# hash      -> deterministic offline embeddings (no downloads, no API key)
# openai    -> OpenAI embeddings API
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384

# Only needed for EMBEDDING_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Retrieval defaults ---
DEFAULT_TOP_K=8
